{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCompletion Run Summary",
  "type": "object",
  "required": [
    "task_id",
    "run_id",
    "group_id",
    "ground_truth_size",
    "found_size",
    "true_positive_size",
    "false_positive_size",
    "recall_at_stop",
    "precision_at_stop",
    "false_stop"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "run_id": { "type": "string" },
    "group_id": { "type": "string", "enum": ["G1", "G2", "G3", "G6"] },
    "ground_truth_size": { "type": "integer", "minimum": 0 },
    "found_size": { "type": "integer", "minimum": 0 },
    "true_positive_size": { "type": "integer", "minimum": 0 },
    "false_positive_size": { "type": "integer", "minimum": 0 },
    "recall_at_stop": { "type": "number", "minimum": 0, "maximum": 1 },
    "precision_at_stop": { "type": "number", "minimum": 0, "maximum": 1 },
    "pairwise_overlap": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "singleton_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "source_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "holdout_gain": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "mean_self_reported_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "false_stop": { "type": "boolean" },
    "false_convergence": { "type": ["boolean", "null"] }
  },
  "additionalProperties": true
}

