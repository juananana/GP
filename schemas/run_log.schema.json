{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCompletion Run Log",
  "type": "object",
  "required": [
    "task_id",
    "run_id",
    "group_id",
    "agent_id",
    "round_id",
    "prompt_variant",
    "model_name",
    "query_or_action",
    "source_id",
    "new_items",
    "all_items",
    "self_reported_completion",
    "self_reported_confidence",
    "stop_reason"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "run_id": { "type": "string" },
    "group_id": { "type": "string", "enum": ["G1", "G2", "G3", "G6"] },
    "agent_id": { "type": "string" },
    "round_id": { "type": "integer", "minimum": 1 },
    "prompt_variant": { "type": "string" },
    "model_name": { "type": "string" },
    "query_or_action": { "type": "string" },
    "source_id": { "type": "string" },
    "new_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "all_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "item_provenance": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "self_reported_completion": { "type": "boolean" },
    "self_reported_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "stop_reason": { "type": "string" },
    "latency_seconds": {
      "type": "number",
      "minimum": 0
    },
    "token_or_cost": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": true
}

