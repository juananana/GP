\@writefile{toc}{\contentsline {section}{\numberline {6}Experiments and Results}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Evidence-condition controller. The controller maps a runtime evidence log, declared source-route scope, and stop proposal to an exposure distribution over the intended source-route space. The support/Gini check is an eligibility test, not a completion proof. If the condition is localized or weak plausible gaps remain, the controller repairs or continues. It returns \textsc  {Safe}{} only when the evidence condition is broad and repair or audit reveals no residual evidence; otherwise it returns \textsc  {Continue}{} or \textsc  {Abstain}{}.}}{4}{}\protected@file@percent }
\newlabel{fig:controller}{{2}{4}{}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Local stop evidence causes false certification.}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Diagnostic evidence for the stop condition. Source-only exposure looks complete at localized stops, but source-route support reveals route mismatch and low post-hoc recall; numbers above panel (a) are the source-only minus source-route support gaps. The support--Gini view shows how route-partitioned and extended audits move toward the configured eligibility region. The \texttt  {urllib3} boundary is one fixed eligible-but-residual-positive state: support \(0.800\), recall \(0.835\), and 115 missed oracle items before the extended audit reaches full support and recall.}}{5}{}\protected@file@percent }
\newlabel{fig:main_results}{{3}{5}{}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Source-only coverage hides route mismatch.}{5}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Source-route geometry exposes the mismatch.}{5}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Eligibility is only a precondition.}{5}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Full control is safe and actionable.}{5}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Residual repair gives gain at audit cost.}{5}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Source-only versus source-route ablation. Homogeneous agents visit all sources, so a source-only controller would see full source support even when the source-route evidence condition is localized and the stop would be a false certification.}}{6}{}\protected@file@percent }
\newlabel{tab:source_only_ablation}{{1}{6}{}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Repair cost evaluation. Panel (a) shows budget frontiers: increasing post-stop audit budget exposes more residual evidence, with residual- and high-potential targeting dominating random repair in these states. Panel (b) shows the configured main-budget comparison with uncertainty intervals. Decision counts for safe/actionable controller behavior are reported in Table~\ref {tab:main_controller_counts}; this figure isolates the cost side of the tradeoff.}}{6}{}\protected@file@percent }
\newlabel{fig:controller_variants}{{4}{6}{}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Boundary case showing why eligibility is not proof. The state passes the source-route eligibility gate, but post-hoc recall remains below the completion threshold; runtime weak-gap control therefore returns CONTINUE rather than SAFE.}}{6}{}\protected@file@percent }
\newlabel{tab:eligibility_boundary}{{2}{6}{}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Seeded unsafe/complete controller decision counts. Unsafe and Complete are the seeded denominators; FCR is SAFE-on-unsafe divided by Unsafe, and safe coverage is SAFE-on-complete divided by Complete. These denominators differ from the one-state eligibility boundary in Table~\ref {tab:eligibility_boundary}. Oracle labels are used only after decisions are fixed. S/C/A reports SAFE/CONTINUE/ABSTAIN counts.}}{6}{}\protected@file@percent }
\newlabel{tab:main_controller_counts}{{3}{6}{}{table.3}{}}
