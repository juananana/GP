{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCompletion Incidence Log",
  "description": "One row per observed item occurrence in a discovery run. Oracle fields are used only for offline scoring and must not be exposed to blind agents.",
  "type": "object",
  "required": [
    "task_id",
    "task_family",
    "case_id",
    "seed",
    "group_id",
    "run_id",
    "agent_id",
    "item_id",
    "canonical_item",
    "source_id",
    "support_count",
    "is_singleton",
    "aggregation_status",
    "audit_status"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "task_family": { "type": "string" },
    "case_id": { "type": "string" },
    "seed": { "type": "string" },
    "group_id": { "type": "string" },
    "run_id": { "type": "string" },
    "agent_id": { "type": "string" },
    "round_id": { "type": ["integer", "null"], "minimum": 1 },
    "prompt_variant": { "type": ["string", "null"] },
    "model_name": { "type": ["string", "null"] },
    "item_id": { "type": "string" },
    "canonical_item": { "type": "string" },
    "source_id": { "type": "string" },
    "source_bin": { "type": ["string", "null"] },
    "query_path": { "type": ["string", "null"] },
    "first_seen_round": { "type": ["integer", "null"], "minimum": 1 },
    "support_count": { "type": "integer", "minimum": 1 },
    "is_singleton": { "type": "boolean" },
    "self_reported_completion": { "type": ["boolean", "null"] },
    "self_reported_confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "aggregation_status": {
      "type": "string",
      "enum": ["consensus", "minority", "singleton", "holdout", "single_agent", "unknown"]
    },
    "audit_status": {
      "type": "string",
      "enum": ["not_required", "pending", "holdout_confirmed", "holdout_new", "not_applicable"]
    },
    "oracle_label": { "type": ["boolean", "null"] },
    "oracle_bucket": { "type": ["string", "null"] },
    "reportable": { "type": "boolean" },
    "experimental_status": { "type": "string" }
  },
  "additionalProperties": true
}
